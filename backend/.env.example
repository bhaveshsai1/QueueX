# ========================================================
# SMART OPD SYSTEM - FIREBASE CONFIGURATION
# ========================================================

# OPTION 1: Service Account JSON File Path (RECOMMENDED)
# Simply place your downloaded service account JSON file in the project root or backend/
# as 'firebase-service-account.json', or specify its path here:
FIREBASE_CREDENTIALS=firebase-service-account.json

# OPTION 2: Direct Environment Variables (Useful for Cloud Hosting like Vercel/Render)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# API & Server Configuration
PORT=8000
FRONTEND_URL=http://localhost:3000

